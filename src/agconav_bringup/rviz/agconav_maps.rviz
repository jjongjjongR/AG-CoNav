# 저장된 지도 산출물 전용 뷰어 설정 (시뮬 없이 결과만 본다).
#
#   ./scripts/view_maps.py --factor 4      # 먼저 이걸 띄우고
#   rviz2 -d <이 파일>                      # 이걸 띄운다
#
# 여기 있는 토픽은 전부 /viz/ 접두어다. 파이프라인 계약 토픽이 아니라
# view_maps.py가 축소해서 따로 내보내는 시각화 전용 토픽이다.
#
# 원본(0.10 m/cell, 5,010만 셀)을 그대로 띄우면 안 된다:
#   Map 표시     -> RViz 프로세스가 그대로 종료
#   GridMap 표시 -> 22.6 GB 점유, 화면이 안 움직임
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 50
      Plane Cell Count: 20
      Color: 90; 90; 90
      Reference Frame: map

    # ── 모듈 A: 드론이 훑어 만든 2.5D 지도 ───────────────────────
    - Class: grid_map_rviz_plugin/GridMap
      Name: 모듈A 드론 2.5D 지도
      Enabled: true
      Topic:
        Value: /viz/drone/elevation_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Show Grid Lines: false
      Height Layer: elevation
      Color Layer: elevation
      Color Transformer: ColorLayer
      Use Rainbow: true
      Alpha: 1

    # ── 모듈 E: 드론+wheel+leg 병합 결과 ─────────────────────────
    - Class: grid_map_rviz_plugin/GridMap
      Name: 모듈E 병합 지도
      Enabled: false
      Topic:
        Value: /viz/merged/elevation_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Show Grid Lines: false
      Height Layer: elevation
      Color Layer: elevation
      Color Transformer: ColorLayer
      Use Rainbow: true

    # ── 모듈 D: 지상 로봇이 쌓은 지도 ────────────────────────────
    # 로봇이 다닌 좁은 영역만 있어서 드론 지도에 묻힌다. 따로 켜서 봐야 한다.
    - Class: grid_map_rviz_plugin/GridMap
      Name: 모듈D wheel 지상지도
      Enabled: false
      Topic:
        Value: /viz/wheel/elevation_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Show Grid Lines: false
      Height Layer: elevation
      Color Layer: elevation
      Color Transformer: ColorLayer
      Use Rainbow: true

    - Class: grid_map_rviz_plugin/GridMap
      Name: 모듈D leg 지상지도
      Enabled: false
      Topic:
        Value: /viz/leg/elevation_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Show Grid Lines: false
      Height Layer: elevation
      Color Layer: elevation
      Color Transformer: ColorLayer
      Use Rainbow: true

    # ── 모듈 F: 주행 가능 맵 ─────────────────────────────────────
    # 축소할 때 점유를 우선했다(블록에 장애물이 하나라도 있으면 장애물).
    # 보수적인 쪽이라 실제보다 막힌 곳이 넓게 보인다.
    - Class: rviz_default_plugins/Map
      Name: 모듈F wheel 주행가능맵
      Enabled: false
      Topic:
        Value: /viz/wheel/nav_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
      Draw Behind: false

    - Class: rviz_default_plugins/Map
      Name: 모듈F leg 주행가능맵
      Enabled: false
      Topic:
        Value: /viz/leg/nav_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
      Draw Behind: false

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 900
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 0.8
      Target Frame: map
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
