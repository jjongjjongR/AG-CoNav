<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="Seongdong_gu">

        <!-- Plugin for simulating physics -->
        <plugin
                filename="gz-sim-physics-system"
                name="gz::sim::systems::Physics">
        </plugin>

        <!-- Plugin for handling user commands -->
        <plugin
                filename="gz-sim-user-commands-system"
                name="gz::sim::systems::UserCommands">
        </plugin>

        <!-- Plugin for broadcasting scene updates -->
        <plugin
                filename="gz-sim-scene-broadcaster-system"
                name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <!-- Plugin for handling sensors like the LIDAR -->
        <plugin
                filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- Plugin for IMU -->
        <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
        </plugin>

        <!-- plugin for GPS  -->
        <plugin
                filename="gz-sim-navsat-system"
                name="gz::sim::systems::NavSat">
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 -7000 7000 0 0 0</pose>
            <diffuse>0.9 0.88 0.82 1</diffuse>
            <!-- Zero specular prevents glint/reflection artifacts on terrain -->
            <specular>0 0 0 1</specular>
            <!-- gz-sim/OGRE2 bug: shadow map artifact appears when both X and Y are non-zero.
                 Workaround: keep one horizontal component zero. Y-only = sun from north. -->
            <direction>0.0 0.6 -0.6</direction>
        </light>

        <scene>
            <!-- Ambient fills in shadows — simulates sky/bounce light -->
            <ambient>0.45 0.48 0.55 1</ambient>
            <grid>false</grid>
            <origin_visual>false</origin_visual>
            <!-- Procedural sky with atmosphere scattering and clouds -->
            <sky>
                <time>10</time>
                <sunrise>6</sunrise>
                <sunset>20</sunset>
                <clouds>
                    <speed>12</speed>
                </clouds>
            </sky>
        </scene>

        <!-- Polymath standard physics simulation engine config,
        ODE does not behave correctly with heightmaps, we'll use bullet instead -->
        <!--        <physics type='ode'>-->
        <!--            <max_step_size>0.005</max_step_size>-->
        <!--            <real_time_factor>1</real_time_factor>-->
        <!--            <real_time_update_rate>200</real_time_update_rate>-->
        <!--        </physics>-->
        <physics name="1ms" type="ignored">
            <dart>
                <!-- Heightmaps behave better with the bullet collision detector -->
                <collision_detector>bullet</collision_detector>
            </dart>
        </physics>
        <gravity>0 0 -9.8066</gravity>

        <gui fullscreen='0'>
            <!-- 3D scene — camera_pose: 80m above launch point, north (yaw=π/2), 30° nose down (pitch=π/6) -->
            <plugin filename="MinimalScene" name="3D View">
                <gz-gui>
                    <title>3D View</title>
                    <property type="bool" key="showTitleBar">false</property>
                    <property type="string" key="state">docked</property>
                </gz-gui>
                <engine>ogre2</engine>
                <scene>scene</scene>
                <ambient_light>0.4 0.4 0.4</ambient_light>
                <background_color>0.8 0.8 0.8</background_color>
                <!-- 로봇 3대(wheel -159.7,147.5 / drone -156.5,148.2 / leg -158.9,150.8)를
                     한 화면에 담는 초기 시점. 원점 일대는 건물이 덮고 있어 개활지로 옮겼다.
                     이 값과 X3 pose는 scripts/capture_poses.py 의 apply 옵션으로 갱신한다.
                     지형 전체를 보려면 0 0 217.4 0 1.3963 1.5708 로 되돌린다. -->
                <camera_pose>0 -385 385 0 0.75 1.5708</camera_pose>
                <camera_clip>
                    <near>0.1</near>
                    <far>50000</far>
                </camera_clip>
            </plugin>
            <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
                <gz-gui>
                    <property key="state" type="string">floating</property>
