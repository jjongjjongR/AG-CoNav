<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="agconav_500m_world">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- GPU LiDAR 센서를 동작시키는 시스템 -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <!-- 500m × 500m 바닥 -->
    <model name="ground_500m">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>

      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>500 500 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>500 500 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.38 0.35 1</ambient>
            <diffuse>0.45 0.48 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 파란색 더미 드론 -->
    <model name="drone">
      <static>true</static>
      <pose>0 0 12 0 0 0</pose>

      <link name="base_link">
        <visual name="body">
          <geometry>
            <box>
              <size>2.5 2.5 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.2 0.9 1</ambient>
            <diffuse>0.05 0.3 1 1</diffuse>
          </material>
        </visual>

        <!-- +Y축으로 90도 회전하여 아래쪽을 바라봄 -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 -0.4 0 1.5708 0</pose>
          <topic>/drone/lidar</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>

          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.2618</min_angle>
                <max_angle>0.2618</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.3</min>
              <max>100</max>
              <resolution>0.02</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
    </model>

    <!-- 초록색 더미 4륜 로봇 -->
    <model name="wheel">
      <static>true</static>
      <pose>-12 0 0.75 0 0 0</pose>

      <link name="base_link">
        <visual name="body">
          <geometry>
            <box>
              <size>3 2 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.7 0.1 1</ambient>
            <diffuse>0.1 0.9 0.2 1</diffuse>
          </material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 1.0 0 0 0</pose>
          <topic>/wheel/lidar</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>

          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.2618</min_angle>
                <max_angle>0.2618</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.3</min>
              <max>80</max>
              <resolution>0.02</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
    </model>

    <!-- 주황색 더미 4족 로봇 -->
    <model name="leg">
      <static>true</static>
      <pose>12 0 0.9 0 0 0</pose>

      <link name="base_link">
        <visual name="body">
          <geometry>
            <box>
              <size>2.5 1.3 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.3 0.05 1</ambient>
            <diffuse>1 0.4 0.05 1</diffuse>
          </material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.9 0 0 0</pose>
          <topic>/leg/lidar</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>

          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.2618</min_angle>
                <max_angle>0.2618</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.3</min>
              <max>80</max>
              <resolution>0.02</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
