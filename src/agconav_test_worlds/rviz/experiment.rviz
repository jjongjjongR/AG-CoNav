Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 20
      Color: 100; 100; 100
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 5
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR 스캔 (/drone/points)
      Enabled: true
      Topic:
        Value: /drone/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Decay Time: 0
      Alpha: 1
    - Class: grid_map_rviz_plugin/GridMap
      Name: 드론 2.5D 지도 (/drone/elevation_map)
      Enabled: true
      Topic:
        Value: /drone/elevation_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Grid Map Layer: elevation
      Color Layer: elevation
      Color Transformer: IntensityLayer
      Use Rainbow: true
      Invert Rainbow: false
      Show Grid Lines: false
      Height Transformer: GridMapLayer
      Height Layer: elevation
      Alpha: 1
    - Class: rviz_default_plugins/Map
      Name: wheel 주행가능 지도
      Enabled: true
      Topic:
        Value: /wheel/nav_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: leg 주행가능 지도
      Enabled: false
      Topic:
        Value: /leg/nav_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 190
      Focal Point:
        X: 11.4
        Y: -116.1
        Z: 4
      Pitch: 0.9
      Yaw: 0.8
      Target Frame: map
      Near Clip Distance: 0.1
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1700
  Hide Left Dock: false
  Hide Right Dock: true
