                </gz-gui>
            </plugin>
        </gui>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>37.54233814881853</latitude_deg>
            <longitude_deg>127.06050643805561</longitude_deg>
            <elevation>15.400000000001455</elevation>
        </spherical_coordinates>

        <!-- OGRE2 ignores both model and link <pose> for heightmap visuals;
             visual position is controlled by <heightmap><pos> (world frame).
             DART ignores <heightmap><pos> for collision; collision position
             is controlled by <collision><pose> (standard SDF pose chain). -->
        <model name="Seongdong_gu">
            <static>true</static>
            <pose>0 0 0 0 0 0</pose>

            <link name="ground">
                <collision name="collision">
                    <pose>11.4000 -116.1000 1.202132 0 0 0</pose>
                    <geometry>
                        <heightmap>
                            <uri>mesh/height_map.png</uri>
                            <size>100.0000 100.0000 5.249597</size>
                            <!-- DART ignores <pos> for collision heightmaps; positioning
                                 is handled by <collision><pose> above instead -->
                            <pos>0 0 0</pos>
                        </heightmap>
                    </geometry>
                </collision>
                <visual name="ground_visual">
                    <geometry>
                        <heightmap>
                            <use_terrain_paging>false</use_terrain_paging>
                            <texture>
                                <diffuse>mesh/aerial.png</diffuse>
                                <normal>mesh/normal_map.png</normal>
                                <size>100.0000</size>
                            </texture>
                            <uri>mesh/height_map.png</uri>
                            <size>100.0000 100.0000 5.249597</size>
                            <!-- OGRE2 ignores model/link <pose> for heightmaps; <pos> is world frame -->
                            <pos>11.4000 -116.1000 1.202132</pos>
                            <!-- sampling: mesh vertices per heightmap pixel (SDF 1.8+ default = 1).
                                 Tested with 16-bit heightmaps at sampling 1, 4, 8: no visual or
                                 physics difference observed — OGRE2 interpolates extra vertices but
                                 the result is indistinguishable at SRTM source resolution. Higher
                                 values only increase vertex buffer memory (cost scales as sampling²).
                                 sdformat PR #459 changed default from 2->1: "no good reason to
                                 subsample by default". Explicitly set to 1 to match intent. -->
                            <sampling>1</sampling>
                        </heightmap>
                    </geometry>
                </visual>
            </link>


        <!-- ===================== -->
        <!-- Buildings model -->
        <!-- ===================== -->
        <model name="Seongdong_gu_buildings">
            <static>true</static>
            <!-- XY shifts buildings from tile-center-origin (AEQD) to launch-point-origin (world).
                 Z is 0 because building mesh Z values are already in world space (baked by GeoJSONToDAE). -->
            <pose>11.39 1.61 0 0 0 0</pose>
            <link name="buildings">
                <visual name="buildings_visual">
                    <geometry>
                        <mesh>
                            <uri>mesh/buildings.dae</uri>
                            <scale>1 1 1</scale>
                        </mesh>
                    </geometry>
                    <material>
                        <!-- Light grey -->
                        <ambient>0.75 0.75 0.75 1</ambient>
                        <diffuse>0.85 0.85 0.85 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                        <emissive>0 0 0 1</emissive>
                    </material>
                </visual>
                <collision name="buildings_collision">
                    <geometry>
                        <mesh>
                            <uri>mesh/buildings.dae</uri>
                            <scale>1 1 1</scale>
                        </mesh>
                    </geometry>
                </collision>
            </link>
        </model>



        </model>

        <include>
      <name>oak_tree_21</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-33.379700 -66.175300 1.795860 0.000000 -0.000000 0.000000</pose>
      <scale>6.0 6.0 6.0</scale>
    </include>
    <!-- 드론(모듈 A). agconav_integrated.sdf에서 그대로 이식.
         wheel(-5, 0) / leg(5, 0) 사이에 배치되어 지상 로봇 2대와
         함께 초기 GUI 시점에 들어온다. -->
    <include>
      <uri>
        model://agconav_drone
      </uri>
      <name>X3</name>
      <pose>-5.3980 -85.4580 2.1502 -0.0144 -0.0345 -0.3897</pose>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.436e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_1_joint</jointName>
        <linkName>X3/rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.436e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_2_joint</jointName>
        <linkName>X3/rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.436e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>2</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_3_joint</jointName>
        <linkName>X3/rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.436e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>3</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>X3</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>X3/base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>

        <rotorConfiguration>
          <rotor>
            <jointName>X3/rotor_0_joint</jointName>
            <forceConstant>8.436e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_1_joint</jointName>
            <forceConstant>8.436e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_2_joint</jointName>
            <forceConstant>8.436e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_3_joint</jointName>
            <forceConstant>8.436e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <!-- 드론 TF: 센서 메시지의 frame_id가 drone/* 이므로 TF도 같은 이름으로
             내보내야 모듈 A가 점군을 map으로 변환할 수 있다. 기본값(X3/odom ->
             X3/base_footprint)은 센서 프레임과 이름이 맞지 않아 TF가 끊긴다. -->
        <odom_frame>map</odom_frame>
        <robot_base_frame>drone/base_link</robot_base_frame>
      </plugin>
    </include>

    </world>
</sdf>
