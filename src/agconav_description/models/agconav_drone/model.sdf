                    </mesh>
                </geometry>
                <material>
                    <ambient>0.15 0.17 0.09 1</ambient>
                    <diffuse>0.24 0.27 0.13 1</diffuse>
                    <specular>0.05 0.05 0.05 1</specular>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="X3/rotor_0_joint" type="revolute">
            <child>X3/rotor_0</child>
            <parent>X3/base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
