            </axis>
        </joint>
        <!-- X3 mesh(scale=3)의 중앙 하단 z=-0.143556 m에 OS1-32 상단이
             맞닿는 위치보다 0.005 m 위인 z=-0.175406 m에 하우징 중심을 둔다.
             하향 스캔 방향은 별도 os1_lidar 링크에서 pitch +90도로 정의한다. -->
        <link name="os1_lidar_mount">
            <pose>0 0 -0.175406 0 0 0</pose>
            <inertial>
                <mass>0.329</mass>
                <inertia>
                    <ixx>1e-4</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-4</iyy>
                    <iyz>0</iyz>
                    <izz>1e-4</izz>
                </inertia>
            </inertial>
            <visual name="os1_lidar_mount_visual">
                <geometry>
                    <cylinder>
                        <radius>0.0435</radius>
                        <length>0.0737</length>
                    </cylinder>
                </geometry>
            </visual>
            <gravity>0</gravity>
        </link>
        <joint name="os1_lidar_mount_joint" type="fixed">
            <parent>X3/base_link</parent>
            <child>os1_lidar_mount</child>
        </joint>
        <link name="os1_lidar">
            <pose>0 0 -0.175406 0 1.5708 0</pose>
            <inertial>
                <mass>0.001</mass>
                <inertia>
                    <ixx>1e-8</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-8</iyy>
                    <iyz>0</iyz>
                    <izz>1e-8</izz>
                </inertia>
            </inertial>
            <sensor name="os1_lidar" type="gpu_lidar">
                <topic>drone/points</topic>
                <gz_frame_id>drone/os1_lidar</gz_frame_id>
                <update_rate>10</update_rate>
                <always_on>1</always_on>
                <visualize>true</visualize>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>1024</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.141593</min_angle>
                            <max_angle>3.141593</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>32</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.370010</min_angle>
                            <max_angle>0.370010</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.5</min>
                        <max>170.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
            <gravity>0</gravity>
        </link>
        <joint name="os1_lidar_joint" type="fixed">
            <parent>os1_lidar_mount</parent>
            <child>os1_lidar</child>
        </joint>
        <!-- 중앙 상단의 기존 접촉 위치에서 0.005 m 아래로 조정한다.
             GPS에는 collision이 없어 동체와 겹쳐도 접촉력은 발생하지 않는다. -->
        <link name="gps_link">
            <pose>0 0 0.172223 0 0 0</pose>
            <inertial>
                <mass>0.05</mass>
                <inertia>
                    <ixx>1e-5</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-5</iyy>
                    <iyz>0</iyz>
                    <izz>1e-5</izz>
                </inertia>
            </inertial>
            <visual name="gps_link_visual">
                <geometry>
                    <box>
                        <size>0.04 0.04 0.02</size>
                    </box>
                </geometry>
            </visual>
            <sensor name="navsat_sensor" type="navsat">
                <topic>drone/gps</topic>
                <gz_frame_id>drone/gps_link</gz_frame_id>
                <update_rate>10</update_rate>
                <always_on>1</always_on>
            </sensor>
            <gravity>0</gravity>
        </link>
        <joint name="gps_joint" type="fixed">
            <parent>X3/base_link</parent>
            <child>gps_link</child>
        </joint>
    </model>
</sdf>
