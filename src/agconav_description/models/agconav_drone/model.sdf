<sdf version="1.6">
    <model name="x3">
        <pose>0 0 0.159906 0 0 0</pose>
        <link name="X3/base_link">
            <pose frame="">0 0 0 0 -0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>14.5</mass>
                <inertia>
                    <ixx>3.0237981</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>6.09</iyy>
                    <iyz>0</iyz>
                    <izz>8.4999</izz>
                </inertia>
            </inertial>
            <collision name="X3/base_link_inertia_collision">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>1.41 1.41 0.33</size>
                    </box>
                </geometry>
            </collision>
            <visual name="X3/base_link_inertia_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>3 3 3</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/x3.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.20 0.22 0.12 1</ambient>
                    <diffuse>0.30 0.33 0.16 1</diffuse>
                    <specular>0.05 0.05 0.05 1</specular>
                </material>
            </visual>
            <!-- IMU: base_link 내부에 센서만 추가 -->
            <sensor name="drone_imu_sensor" type="imu">
                <pose>0 0 -0.04 0 0 0</pose>
                <topic>drone/imu</topic>
                <gz_frame_id>drone/base_link</gz_frame_id>
                <update_rate>100</update_rate>
                <always_on>1</always_on>
            </sensor>
            <!-- drone_pose_controller가 SetEntityPose로 순간이동시키는 kinematic 운용 방식이라
                 (README 3.1), 모터 플러그인이 힘을 안 주는 동안 중력만으로 처지지 않도록 끈다.
                 로터 관절/모터 플러그인은 그대로 유지 - 나중에 다른 기능에서 쓸 수 있다. -->
            <gravity>0</gravity>
        </link>
        <link name="X3/rotor_0">
            <pose frame="">0.39 -0.66 0.069 0 -0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.125</mass>
                <inertia>
                    <ixx>0.000219375</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.0093834225</iyy>
                    <iyz>0</iyz>
                    <izz>0.0095859225</izz>
                </inertia>
            </inertial>
            <collision name="X3/rotor_0_collision">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.015</length>
                        <radius>0.3</radius>
                    </cylinder>
                </geometry>
                <surface>
