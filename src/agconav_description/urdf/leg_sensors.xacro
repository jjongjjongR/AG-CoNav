<?xml version="1.0"?>
<!-- Go2(leg) 센서 오버레이: OS1-32 + GPS + IMU.
     외부 저장소(unitree_go2_ros2_jazzy)를 수정하지 않고 링크·조인트만 덧붙인다. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="leg_sensors">

  <xacro:macro name="leg_sensors" params="parent:=base_link ns:=leg">

    <!-- ===== OS1-32 LiDAR ===== -->
    <link name="os1_lidar">
      <inertial>
        <mass value="0.33"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="0.0435" length="0.0737"/></geometry>
        <material name="lidar_dark"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.0435" length="0.0737"/></geometry>
      </collision>
    </link>
    <joint name="os1_lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="os1_lidar"/>
      <origin xyz="0.0 0.0 0.12" rpy="0 0 0"/>
    </joint>

    <!-- ===== GPS ===== -->
    <link name="gps_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual><geometry><box size="0.04 0.04 0.02"/></geometry></visual>
    </link>
    <joint name="gps_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="gps_link"/>
      <origin xyz="-0.08 0.0 0.10" rpy="0 0 0"/>
    </joint>

    <!-- ===== Gazebo 센서 정의 ===== -->
    <gazebo reference="os1_lidar">
      <sensor name="os1_lidar" type="gpu_lidar">
        <topic>${ns}/points</topic>
        <gz_frame_id>os1_lidar</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples><resolution>1</resolution>
              <min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples><resolution>1</resolution>
              <min_angle>-0.370010</min_angle><max_angle>0.370010</max_angle>
            </vertical>
          </scan>
          <range><min>0.5</min><max>170.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="${parent}">
      <sensor name="imu_sensor" type="imu">
        <topic>${ns}/imu</topic>
        <gz_frame_id>${parent}</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
      </sensor>
    </gazebo>

    <gazebo reference="gps_link">
      <sensor name="navsat_sensor" type="navsat">
        <topic>${ns}/gps</topic>
        <gz_frame_id>gps_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>