{
  /*** Global Configuration ***/
  "global": {
    "config_path": "",
    "config_ros": "config_ros.json",
    "config_logging": "config_logging.json",
    "config_viewer": "config_viewer.json",
    "config_sensors": "config_sensors.json",
    "config_preprocess": "config_preprocess.json",
    "config_gnss_global": "config_gnss_global.json",

    // 5m AGL 실험(2026-08, run_results/PROGRESS.md 4단계)에서 CT+passthrough+
    // pose_graph 조합으로 고정. 원래 이 조합은 IMU 회전이 안 잡히는 teleport류
    // bag용으로 문서화돼 있었지만(아래), 이번 velocity bag(실제 IMU 운동 있음)에도
    // 그대로 쓴다 — 이 환경에 GPU가 없어(1단계 조사에서 확인) GPU 조합
    // (config_odometry_gpu.json 등, CUDA 필요)은 애초에 못 돌리고, CT는
    // CPU 오도메트리라 이 환경에서 실행 가능한 유일한 실전 선택지다. 사용자가
    // 확정한 조합.
    //
    // GLIM 기본 구성(LiDAR-IMU 융합, GPU 필요) 참고용 — exp_velocity 는 멀티콥터
    // 속도 제어로 실제 비행한 데이터라 IMU가 운동을 반영한다(gyro 최대 0.96 rad/s
    // = 55 deg/s). SetEntityPose 순간이동으로 만든 bag(exp_teleport 등)의 IMU는
    // 전 비행 구간 gyro 최대 0.0013 rad/s 로, 180도 선회를 두 번 하는 경로인데도
    // 회전을 감지하지 못해 이 구성을 쓸 수 없었다:
    //   "config_odometry":       "config_odometry_gpu.json",
    //   "config_sub_mapping":    "config_sub_mapping_gpu.json",
    //   "config_global_mapping": "config_global_mapping_gpu.json"
    //
    // CT 오도메트리는 IMU 없이 추정하므로 기본 sub_mapping/global_mapping이
    // "odom frames are not estimated in the IMU frame"으로 거부한다 —
    // passthrough/pose_graph로 함께 내려야 한다:
    "config_odometry": "config_odometry_ct.json",
    "config_sub_mapping": "config_sub_mapping_passthrough.json",
    "config_global_mapping": "config_global_mapping_pose_graph.json"
  }
}
