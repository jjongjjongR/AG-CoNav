{
  /*** gnss_global (glim_ext) ***
  // gnss_topic      : geometry_msgs/PoseWithCovarianceStamped 토픽. position.xyz는
  //                   반드시 하나의 고정 데카르트 프레임(ENU 등)이어야 한다 -- 모듈은
  //                   자기 GLIM map 프레임과 이 프레임 사이의 정렬(T_world_utm)을
  //                   submap 궤적과 대조해 자동으로 추정한다("utm"이라는 변수명은
  //                   관례일 뿐, 실제로 UTM 투영을 요구하지 않는다).
  //                   우리 /drone/gps(NavSatFix, WGS84)는 그대로 넣을 수 없어
  //                   run_results/diag_scripts/navsat_to_gnss_pose.py로
  //                   pymap3d ENU 변환 후 이 토픽에 재발행한다(world 원점
  //                   lat/lon/alt는 run_results/PROGRESS.md 3-2절에서 검증된 값).
  // min_baseline    : 정렬 추정을 시작하기 전 submap 궤적이 이동해야 하는
  //                   최소 거리(m) -- glim_ext 기본값(10.0) 그대로 사용.
  // prior_inf_scale : [x, y, z] 정보(inverse-covariance) 가중치. z=0.0은
  //                   GPS 고도를 신뢰하지 않는다는 뜻(glim_ext 기본값, 이번
  //                   실험에서도 그대로 -- GPS z 정확도를 별도로 검증하지
  //                   않았으므로 안전한 기본값 유지).
  */
  "gnss": {
    "gnss_topic": "/gnss",
    "min_baseline": 10.0,
    "prior_inf_scale": [
      1e3,
      1e3,
      0.0
    ]
  }
}
